    <!-- Before Tips -->
    <string name="prep_before_1_title">Listen to Weather Reports</string>
    <string name="prep_before_1_desc">Always listen to weather reports from PAGASA and NDRRMC to be prepared for storm and flood warnings.</string>
    <string name="prep_before_2_title">Prepare an Emergency Kit</string>
    <string name="prep_before_2_desc">Prepare an Emergency Kit containing food, water, medicine, flashlight, batteries, and important documents.</string>
    <string name="prep_before_3_title">Relocate Important Items</string>
    <string name="prep_before_3_desc">Move important belongings such as documents, electronics, and furniture to the upper floors to prevent flood damage.</string>
    <string name="prep_before_4_title">Check Your Home\'s Stability</string>
    <string name="prep_before_4_desc">Make sure your home is sturdy and there are no holes or gaps that floodwater could enter through.</string>
    <string name="prep_before_5_title">Know the Evacuation Center</string>
    <string name="prep_before_5_desc">Know the nearest evacuation center and safe routes to get there so you can evacuate quickly if needed.</string>
    <string name="prep_before_6_title">Use the SALBA-bida App</string>
    <string name="prep_before_6_desc">For additional preparation, use the SALBA-bida app to receive real-time updates and emergency assistance.</string>

    <!-- During Tips -->
    <string name="prep_during_1_title">Stay in a Safe Place</string>
    <string name="prep_during_1_desc">Stay in a safe area and avoid wading in floodwater, especially if you don\'t know its depth, to prevent danger.</string>
    <string name="prep_during_2_title">Turn Off Electricity</string>
    <string name="prep_during_2_desc">Make sure the main power switch is off and avoid cables or outlets submerged in water to prevent electrocution.</string>
    <string name="prep_during_3_title">Stay Tuned to News</string>
    <string name="prep_during_3_desc">Continue to follow news for updates and advisories from authorities to stay safe and prepared.</string>
    <string name="prep_during_4_title">Stay Calm and Ready</string>
    <string name="prep_during_4_desc">Stay alert for approaching rescuers and don\'t panic so you can be evacuated more easily if necessary.</string>
    <string name="prep_during_5_title">Use the SALBA-bida App</string>
    <string name="prep_during_5_desc">Monitor the SALBA-bida app to keep your Barangay alert about your area\'s condition and receive important updates.</string>

    <!-- After Tips -->
    <string name="prep_after_1_title">Check Electricity Before Turning On</string>
    <string name="prep_after_1_desc">Make sure no live cables or outlets are submerged in water before turning on electricity to ensure safety.</string>
    <string name="prep_after_2_title">Report Damaged Facilities</string>
    <string name="prep_after_2_desc">Report damaged facilities such as power poles, water pipes, and others to authorities to prevent further damage or accidents.</string>
    <string name="prep_after_3_title">Avoid Dirty Water</string>
    <string name="prep_after_3_desc">Avoid wading in dirty floodwater to prevent sickness and infection.</string>
    <string name="prep_after_4_title">Check SALBA-bida App for Help</string>
    <string name="prep_after_4_desc">Visit the SALBA-bida app for donations from Government and Non-government Organizations as help for those affected by severe flooding.</string>

