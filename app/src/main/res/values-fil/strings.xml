    <!-- Before Tips -->
    <string name="prep_before_1_title">Makinig sa Ulat ng Panahon</string>
    <string name="prep_before_1_desc">Laging makinig sa ulat ng panahon mula sa PAGASA at NDRRMC upang maagapan ang mga babala ukol sa bagyo at pagbaha.</string>
    <string name="prep_before_2_title">Maghanda ng Emergency Kit</string>
    <string name="prep_before_2_desc">Maghanda ng Emergency Kit na may pagkain, tubig, gamot, flashlight, baterya, at mahahalagang dokumento.</string>
    <string name="prep_before_3_title">Ilipat ang Mahahalagang Gamit</string>
    <string name="prep_before_3_desc">Ilipat sa mas mataas na lugar ang mahahalagang gamit tulad ng mga dokumento, electronics, at muwebles upang maiwasan ang pinsala ng baha.</string>
    <string name="prep_before_4_title">Suriin ang Tibay ng Bahay</string>
    <string name="prep_before_4_desc">Tiyaking matibay ang bahay at walang mga butas o puwang na maaaring pasukin ng tubig-baha.</string>
    <string name="prep_before_5_title">Alamin ang Evacuation Center</string>
    <string name="prep_before_5_desc">Alamin ang pinakamalapit na evacuation center at ligtas na ruta upang makapaglipat agad sakaling kailanganin.</string>
    <string name="prep_before_6_title">Gamitin ang SALBA-bida App</string>
    <string name="prep_before_6_desc">Para sa karagdagang paghahanda, gamitin ang SALBA-bida app upang makatanggap ng real-time na update at emergency assistance.</string>

    <!-- During Tips -->
    <string name="prep_during_1_title">Manatili sa Ligtas na Lugar</string>
    <string name="prep_during_1_desc">Manatili sa ligtas na lugar at iwasang lumangoy o lumakad sa baha lalo na kung hindi alam ang lalim nito upang maiwasan ang panganib.</string>
    <string name="prep_during_2_title">Patayin ang Kuryente</string>
    <string name="prep_during_2_desc">Siguraduhing naka-off ang main switch ng kuryente at iwasang hawakan ang mga cable o outlet na nasa tubig-baha upang maiwasan ang electrocution.</string>
    <string name="prep_during_3_title">Manatiling Nakikinig sa Balita</string>
    <string name="prep_during_3_desc">Patuloy na makinig sa balita para sa mga update at advisory mula sa mga awtoridad upang manatiling ligtas at handa.</string>
    <string name="prep_during_4_title">Manatiling Kalmado at Handa</string>
    <string name="prep_during_4_desc">Mag-ingat sa mga paparating na rescue at huwag mag-panic upang mas madali kang matulungan sakaling kinakailangan.</string>
    <string name="prep_during_5_title">Gamitin ang SALBA-bida App</string>
    <string name="prep_during_5_desc">Subaybayan ang SALBA-bida app upang mapanatiling alerto ang iyong Barangay tungkol sa kalagayan ng iyong lugar at makatanggap ng mahahalagang update.</string>

    <!-- After Tips -->
    <string name="prep_after_1_title">Suriin ang Kuryente Bago Buksan</string>
    <string name="prep_after_1_desc">Siguraduhing walang mga live wire o outlet na nakalubog sa tubig bago buksan ang kuryente upang matiyak ang kaligtasan.</string>
    <string name="prep_after_2_title">I-report ang mga Nasirang Pasilidad</string>
    <string name="prep_after_2_desc">I-report ang mga nasirang pasilidad tulad ng poste ng kuryente, tubo ng tubig, at iba pa sa mga awtoridad upang maiwasan ang dagdag na pinsala o aksidente.</string>
    <string name="prep_after_3_title">Iwasan ang Maruming Tubig-Baha</string>
    <string name="prep_after_3_desc">Iwasang lumangoy o lumakad sa maruming tubig-baha upang maiwasan ang sakit at impeksyon.</string>
    <string name="prep_after_4_title">Tingnan ang SALBA-bida App para sa Tulong</string>
    <string name="prep_after_4_desc">Bisitahin ang SALBA-bida app para sa mga donasyon mula sa Government at Non-government Organizations bilang tulong sa mga nasalanta ng matinding pagbaha.</string>

